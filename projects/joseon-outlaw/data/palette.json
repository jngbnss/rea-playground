    },
    "pine": {
      "hex": "#3E5838",
      "role": "소나무 잎, 산길"
    },
    "sunset": {
      "hex": "#E6A25A",
      "role": "해 질 녘 직사광 색(조명 색으로 사용)"
    },
    "fog": {
      "hex": "#8FA1A8",
      "role": "원경 안개, 대기 원근"
    }
