    },
    "ink_soft": {
      "hex": "#3A332D",
      "role": "패널 테두리, 비활성 요소"
    },
    "hanji": {
      "hex": "#F1E7D3",
      "role": "한지. 어두운 패널 위 글자, 밝은 패널 바탕"
    },
    "hanji_shade": {
      "hex": "#CDBE9F",
      "role": "보조 글자, 이름표 아래 줄"
    },
    "dancheong_red": {
      "hex": "#A5402F",
      "role": "적(赤). 체력, 위험, 도적의 천 조각"
    },
    "hp_red": {
      "hex": "#C4553F",
      "role": "어두운 패널 위 체력 바·피격 표시 전용. dancheong_red는 어두운 바탕에서 대비가 부족하다"
    },
    "cheong_blue": {
      "hex": "#2F5868",
