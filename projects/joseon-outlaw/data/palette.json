    {
      "fg": "ink",
      "bg": "hanji",
      "min": 4.5,
      "use": "밝은 패널(퀘스트 두루마리) 본문"
    },
    {
      "fg": "dancheong_red",
      "bg": "hanji",
      "min": 4.5,
